#*****************************************************************************************
# This script will built the Vivado SDK project from the following
# sources:
#    "emulator_top.xsa"
#    "EMU-lator/src"
#    "bootimage/EMU-lator.bif"
#    "bootimage/EMU-lator_debug.bif"
#*****************************************************************************************

# Set the reference directory for source file relative paths (by default the value is script directory path)
set origin_dir "[file normalize "."]"

set c_project_name "EMUlator"
set hw_project_name "emulator_hw_platform"
set xsa_file_name "emulator_top"
set os_name "freertos"

source "../common/shared_procs.tcl"

# Set the build number the first variable passed on the command line or 0 if none given
if { $argc == 0 } {
    set build_number 0
} else {
    set build_number [lindex $argv 0]
}

set build_config "all"

# Get the other named command line arguments, first is --config all/debug/release
if { $argc >= 2 } {
    set index 1
    while {$index < $argc} {
        if {[string equal [lindex $argv $index] "--config"]} {
            incr index
            set build_config [string tolower [lindex $argv $index]]
        }
        if {[string equal [lindex $argv $index] "--clean"]} {
            puts "Clean project directories selected. Running clean script"
            set force_clean true
            source clean_all.tcl
        }
        incr index
    }
    puts "Build config selected: $build_config"
}

# If no valid build config is selected, default to all.
if { $build_config != "all" && $build_config != "release" && $build_config != "debug"} {
    puts "Invalid build config selected, defaulting to all"
    set build_config "all"
}

puts "EMU-lator hardware project $c_project_name"

# Check XSA exists
set xsa_file_name ${xsa_file_name}.xsa
if { ![file exists ${xsa_file_name}] } {
    puts "File $xsa_file_name is missing, exiting."
    exit 1
}

# Set the workspace to the current directory. From now on the results of all other
# commands will end up here.
setws .

# Create main BSP
# Use the hardware package and create a board support package (BSP) for FreeRTOS
# Configure the main BSP to contain the correct libraries and parameters
platform create -name ${hw_project_name} -hw "${xsa_file_name}" -proc ps7_cortexa9_0 -os ${os_name}
domain active ${os_name}_domain

# Configure freertos kernel
bsp config tick_rate 1000
bsp config total_heap_size 262144
bsp config minimal_stack_size 512

# Enable floating point context in tasks.  This is necessary for using avoid corruption of floating point
# registers (used by floating point operations and some GCC library functions) when context switching.
bsp config -append extra_compiler_flags "-DconfigUSE_TASK_FPU_SUPPORT=2 -DconfigSUPPORT_STATIC_ALLOCATION=1 -DLWIP_SO_RCVTIMEO=1 -DSNTP_SUPPORT=1 -DLWIP_UDP=1 -DconfigUSE_TICK_HOOK=1"

# Add and configure Light Weight IP (lwip) library
bsp setlib lwip220
bsp config api_mode SOCKET_API
bsp config lwip_dhcp true
bsp config phy_link_speed CONFIG_LINKSPEED100
bsp config emac_number 1
bsp regenerate

file copy -force "patches/bsp/FreeRTOSConfig.h" "${hw_project_name}/ps7_cortexa9_0/freertos_domain/bsp/ps7_cortexa9_0/include"
file copy -force "patches/bsp/FreeRTOSConfig.h" "${hw_project_name}/ps7_cortexa9_0/freertos_domain/bsp/ps7_cortexa9_0/libsrc/freertos10_xilinx_v1_16/src"
file copy -force "patches/bsp/FreeRTOSConfig.h" "${hw_project_name}/export/${hw_project_name}/sw/${hw_project_name}/freertos_domain/bspinclude/include"


# Create an empty application in the directory where we already keep our sources.
# This way our sources are added to the empty project
platform active ${hw_project_name}
platform generate
app create -name $c_project_name -platform ${hw_project_name} -domain ${os_name}_domain -template "Empty Application" -proc psu_cortexa53_0 -os ${os_name}
app clean -name $c_project_name

# Get the version info from the version.c and print it
set file [open "$c_project_name/src/version.c"]
while {[gets $file line] != -1} {
    if {[regexp {VERSION_([A-Z]+).*([0-9]+)} $line matched version_part value]} {
        dict set version [string tolower $version_part] $value
    }
}
close $file
set version_string [dict get $version major]_[dict get $version minor]_[dict get $version bugfix]_$build_number
puts "Building version: [string map {_ .} $version_string]"

# Use our own linker files instead of autogenerated
file copy -force "patches/lscripts/$c_project_name/lscript.ld" "$c_project_name/src/"

puts "Build config=$build_config"


if { $build_config == "release" || $build_config == "all" } {
    # Build the release version of the Demo and the FSBL
    configapp -app $c_project_name build-config Release
    # Set the build number
    puts "Building release: BUILD_NUMBER=$build_number"
    # Configure main project
    app config -name ${c_project_name} define-compiler-symbols "BUILD_NUMBER=$build_number"
    app config -name ${c_project_name} define-compiler-symbols "CS_PLATFORM=CS_P_ZYNQ"
    app config -name ${c_project_name} define-compiler-symbols "CS_NDEBUG"
    app config -name ${c_project_name} define-compiler-symbols "PROJECT=EMU-lator_APP"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_RHPORT0_MODE=OPT_MODE_HOST"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_MCU=OPT_MCU_ZYNQ70XX"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_OS=OPT_OS_FREERTOS"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUH_ENUMERATION_BUFSIZE=512"
    app config -name ${c_project_name} define-compiler-symbols "configSUPPORT_STATIC_ALLOCATION=1"
    app config -name ${c_project_name} define-compiler-symbols "FILE_SYSTEM_INTERFACE_SD"
    app config -name ${c_project_name} linker-misc { -Xlinker --defsym=_STACK_SIZE=0x200000 }
    app config -name ${c_project_name} linker-misc { -Xlinker --defsym=_HEAP_SIZE=0x200000 }
    app config -name ${c_project_name} libraries "m"
    #projects -build
    app build -name ${c_project_name}
    sysproj build -name ${c_project_name}_system
}

if { $build_config == "debug" || $build_config == "all" } {
    # Build the debug version of the Demo and the FSBL
    # The debug version is build last, so the project remains configured for the debug
    # after it has been generated. This is easier for developers using the project files.
    configapp -app $c_project_name build-config Debug
    # Set the build number
    puts "Building debug: BUILD_NUMBER=$build_number"
    # Configure main application
    app config -name ${c_project_name} define-compiler-symbols "BUILD_NUMBER=$build_number"
    app config -name ${c_project_name} define-compiler-symbols "CS_PLATFORM=CS_P_ZYNQ"
    app config -name ${c_project_name} define-compiler-symbols "DEBUG"
    app config -name ${c_project_name} define-compiler-symbols "PROJECT=EMU-lator_APP"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_RHPORT0_MODE=OPT_MODE_HOST"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_MCU=OPT_MCU_ZYNQ70XX"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUSB_OS=OPT_OS_FREERTOS"
    app config -name ${c_project_name} define-compiler-symbols "CFG_TUH_ENUMERATION_BUFSIZE=512"
    app config -name ${c_project_name} define-compiler-symbols "configSUPPORT_STATIC_ALLOCATION=1"
    app config -name ${c_project_name} define-compiler-symbols "FILE_SYSTEM_INTERFACE_SD"
    app config -name ${c_project_name} linker-misc { -Xlinker --defsym=_STACK_SIZE=0x200000 }
    app config -name ${c_project_name} linker-misc { -Xlinker --defsym=_HEAP_SIZE=0x200000 }
    app config -name ${c_project_name} libraries "m"
    #projects -build
    app build -name ${c_project_name}
    sysproj build -name ${c_project_name}_system
}

# Release Image
exec bootgen -image "bootimage/EMU-lator.bif" -arch zynq -o "../../Build//${c_project_name}_${version_string}_release.bin" -w on -p xc7z020
exec bootgen -image "bootimage/EMU-lator_debug.bif" -arch zynq -o "../../Build/${c_project_name}_${version_string}_debug.bin" -w on -p xc7z020

#This is for potential automation by Jenkins/Gitlab etc
set ver_file [open "version.txt" w+]
puts $ver_file "[string map {_ .} $version_string]"
close $ver_file

exit
